require 'dotenv'
Dotenv.load('.env')

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-26.04"

  # === VMware Fusion 26H1 Specific Configuration ===
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["numvcpus"] = "4"
    v.vmx["memsize"]  = "8192"
    v.gui = false

    v.vmx["firmware"] = "bios"
    v.vmx["ethernet0.virtualDev"] = "vmxnet3"
    v.vmx["scsi0.virtualDev"] = "pvscsi"
    v.vmx["vmci0.present"] = "TRUE"
    v.vmx["encryption.encrypted"] = "TRUE"
  end

  config.ssh.insert_key = false
  config.ssh.private_key_path = ENV['SSH_PVK']

  # Main Hardening via Ansible
  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "full-hardening.yml"
    ansible.extra_vars = {
      worker_user: ENV['WORKER_USER'],
      allowed_subnet: ENV['ALLOWED_SUBNET'],
      ssh_public_key: File.read(ENV['SSH_PBK']).strip
    }
  end

  # SSH Port Forward (for easy access)
  config.vm.network "forwarded_port", guest: 22, host: 2222, host_ip: "127.0.0.1", id: "ssh"
end
